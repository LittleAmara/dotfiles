{
    "editor.minimap.enabled": false,
    "editor.fontFamily": "'Monaspace Neon', 'monospace', monospace",
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'liga'",
    "zenMode.centerLayout": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.showTabs": "multiple",
    "catppuccin.accentColor": "lavender",
    "vscode-neovim.logOutputToConsole": true,
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape",
        }
    },
    "vscode-neovim.ctrlKeysForInsertMode": [
        "a",
        "c",
        "d",
        "j",
        "m",
        "o",
        "r",
        "t",
        "u",
        "w"
    ],
    "vscode-neovim.ctrlKeysForNormalMode": [
        "a",
        "b",
        "c",
        "d",
        "e",
        "f",
        "i",
        "j",
        "l",
        "m",
        "o",
        "r",
        "t",
        "u",
        "v",
        "w",
        "x",
        "y",
        "z",
        "/",
        "]",
        "right",
        "left",
        "up",
        "down",
        "backspace",
        "delete"
    ],
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "GitHub Dark Default",
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "workbench.layoutControl.enabled": false,
    "chat.commandCenter.enabled": false,
    "window.customTitleBarVisibility": "windowed",
    "vscode-neovim.normalSelectionDebounceTime": 20
}